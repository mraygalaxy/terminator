"""Terminator by Chris Jones <cmsj@tenshu.net>"""

import sys
import os

try:
    ORIGCWD = os.getcwd()
except OSError:
    ORIGCWD = os.path.expanduser("~")

# Check we have simple basics like Gtk+ and a valid $DISPLAY
try:
    import gi
    gi.require_version('Gtk','3.0')
    # pylint: disable-msg=W0611
    from gi.repository import Gtk, Gdk, GLib

    if Gdk.Display.get_default() == None:
        print('You need to run terminator in an X environment. ' \
              'Make sure $DISPLAY is properly set')
        sys.exit(1)

except ImportError:
    print('You need to install the python bindings for ' \
           'gobject, gtk and pango to run Terminator.')
    sys.exit(1)

import terminatorlib.optionparse
from terminatorlib.terminator import Terminator
from terminatorlib.factory import Factory
from terminatorlib.version import APP_NAME, APP_VERSION
from terminatorlib.util import dbg, err
from terminatorlib.layoutlauncher import LayoutLauncher
from terminatorlib.configjson import ConfigJson

if __name__ == '__main__':

    dbus_service = None

    dbg ("%s starting up, version %s" % (APP_NAME, APP_VERSION))
  
    GLib.set_prgname(APP_NAME)

    OPTIONS,dbus_options = terminatorlib.optionparse.parse_options()
    if OPTIONS.configjson:
        configjson = ConfigJson()
        layoutname = configjson.extend_config(OPTIONS.configjson)
        if layoutname and ((not OPTIONS.layout) or OPTIONS.layout == 'default'):
            OPTIONS.layout = layoutname
            if not OPTIONS.profile:
               OPTIONS.profile = configjson.get_profile_to_use()
    
    TERMINATOR = Terminator()
    TERMINATOR.set_origcwd(ORIGCWD)

    if OPTIONS.select:
        # launch gui, return selection
        LAYOUTLAUNCHER=LayoutLauncher()
    else:
        # Attempt to import our dbus server. If one exists already we will just
        # connect to that and ask for a new window. If not, we will create one and
        # continue. Failure to import dbus, or the global config option "dbus"
        # being False will cause us to continue without the dbus server and open a
        # window.
        try:
            if OPTIONS.nodbus:
                dbg('dbus disabled by command line')
                raise ImportError
            from terminatorlib import ipc
            import dbus
            try:
                dbus_service = ipc.DBusService()

                if(OPTIONS.reload):
                    # Reload only is executed when exist at least one window,
                    # if not there is nothing to reload
                    sys.exit()

            except ipc.DBusException:
                dbg('Unable to become master process, operating via DBus')
                # get rid of the None and True types so dbus can handle them (empty
                # and 'True' strings are used instead), also arrays are joined 
                # (the -x argument for example)
                if OPTIONS.working_directory is None:
                    OPTIONS.working_directory = ORIGCWD
                    dbus_options['working_directory'] = ORIGCWD
                optionslist = dbus.Dictionary(dbus_options, signature='ss')
                if OPTIONS.new_tab:
                    dbg('Requesting a new tab')
                    ipc.new_tab_cmdline(optionslist)
                elif OPTIONS.toggle_visibility:
                    dbg('requesting to toggle windows visibility')
                    ipc.toggle_visibility_cmdline(optionslist)
                elif OPTIONS.reload:
                    dbg('requesting to reload configuration for all windows')
                    ipc.reload_configuration()
                elif OPTIONS.unhide:
                    print('requesting to unhide windows')
                    ipc.unhide_cmdline(optionslist)
                else:
                    dbg('Requesting a new window')
                    ipc.new_window_cmdline(optionslist)
                sys.exit()
        except ImportError:
            dbg('dbus not imported')
            pass

        MAKER = Factory()
        TERMINATOR.set_dbus_data(dbus_service)
        TERMINATOR.reconfigure()

        try:
            dbg('Creating a terminal with layout: %s' % OPTIONS.layout)
            # If terminator was launched without an explicit --layout
            # flag (i.e. defaulted to 'default'), check for a hidden
            # CRIU session and load it in place. This is what restores
            # the user's last working arrangement — with any
            # checkpointed tabs hooked up to restore via criu — without
            # them having to think about layouts. An explicit
            # --layout=NAME bypasses session loading and uses the
            # named template fresh.
            criu_session_layout = None
            if OPTIONS.layout == 'default':
                try:
                    from terminatorlib.criu import session as _criu_sess
                    criu_session_layout = _criu_sess.load()
                except ImportError:
                    pass
                except Exception as _e:
                    err('CRIU session load failed, falling back to default: %s' % _e)
            if criu_session_layout is not None:
                dbg('Loading CRIU session in place of default layout')
                TERMINATOR.create_layout(OPTIONS.layout, layout=criu_session_layout)
                # IMPORTANT: create_layout() only builds the window/tab
                # widget hierarchy. The actual spawn/restore attempts
                # happen synchronously inside TERMINATOR.layout_done()
                # (below), which loops over every terminal and calls
                # spawn_child() directly — spawn_child() itself no-ops
                # while doing_layout is True, and that flag is only
                # cleared at the top of layout_done(). So the true
                # "everything has now been attempted, one way or
                # another" point is strictly AFTER layout_done() returns
                # — not before it, and not merely once Gtk's main loop
                # starts (layout_done() doesn't need the main loop
                # running at all; it's a plain synchronous for-loop).
                #
                # session.json must not be cleared before that point.
                # Clearing it based on the layout merely having been
                # drawn — before any tab had actually attempted its
                # restore — deletes the only record of each tab's
                # command line, cwd, and checkpoint reference on the
                # assumption that layout-out-not-yet-spawned counts as
                # success. It doesn't: this is exactly what happened
                # before this fix. A crash during the real restore phase
                # destroyed session.json before every tab had even been
                # attempted, and everything not yet reached was gone for
                # good with no way back.
                #
                # The cleanup below now runs only once layout_done() has
                # returned normally — i.e. every terminal's spawn_child()
                # has already run to completion, succeeded or fallen
                # back on its own. A crash from this point on is a new,
                # separate failure, not this script discarding recovery
                # data pre-emptively. And if layout_done() itself never
                # returns (a repeat of the segfault this was written
                # to guard against), the cleanup below simply never
                # runs — session.json survives by construction, not by
                # exception handling.
                consume_criu_session_after_layout = True
            else:
                TERMINATOR.create_layout(OPTIONS.layout)
                consume_criu_session_after_layout = False
            # Wire up the logind PrepareForShutdown / PrepareForSleep
            # listeners so power events trigger auto-checkpointing. The
            # import is guarded so terminator still works on systems
            # without the criu module installed or without systemd-logind.
            try:
                from terminatorlib.criu import lifecycle as _criu_lifecycle
                _criu_lifecycle.install(TERMINATOR)
            except ImportError:
                pass
            except Exception as _e:
                err('CRIU lifecycle install failed: %s' % _e)
        except (KeyError,ValueError) as ex:
            err('layout creation failed, creating a window ("%s")' % ex)
            TERMINATOR.new_window()
            consume_criu_session_after_layout = False
        TERMINATOR.layout_done()
        # Every terminal's spawn_child() has now run to completion (see
        # the long comment above) — safe to consume the session file.
        # Sweep any checkpoint dirs not referenced by the session we
        # just loaded (orphans from a crash or weird shutdown) and drop
        # the one-shot session file so the next launch starts clean
        # unless the user checkpoints again or closes with tabs open.
        if consume_criu_session_after_layout:
            try:
                keep = _criu_sess.referenced_uuids(criu_session_layout)
                _criu_sess.remove_orphan_checkpoints(keep)
                _criu_sess.clear()
            except Exception as _e:
                err('CRIU session cleanup failed: %s' % _e)

    if OPTIONS.debug and OPTIONS.debug >= 2:
        import terminatorlib.debugserver as debugserver
        # pylint: disable-msg=W0611
        import threading

        Gdk.threads_init()
        (DEBUGTHREAD, DEBUGSVR) = debugserver.spawn(locals())
        TERMINATOR.debug_address = DEBUGSVR.server_address

    try:
        Gtk.main()
    except KeyboardInterrupt:
        # User hit Ctrl-C in the launching terminal. Same semantic as
        # an OS shutdown — terminator is about to die and the user
        # wants their tabs back next launch. Skip silently if CRIU
        # isn't wired up.
        try:
            if hasattr(TERMINATOR, 'criu_checkpoint_all_tabs'):
                TERMINATOR.criu_checkpoint_all_tabs(preserve_on_exit=True)
        except Exception as _e:
            err('CRIU checkpoint on Ctrl-C failed: %s' % _e)

